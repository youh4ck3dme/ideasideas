{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test server/*.test.ts src/utils/*.test.ts tests/unit/*.test.ts tests/e2e/*.test.ts",
    "test:unit": "tsx --test server/*.test.ts src/utils/*.test.ts tests/unit/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "check": "tsc --noEmit && tsx --test server/*.test.ts src/utils/*.test.ts tests/unit/*.test.ts tests/e2e/*.test.ts && vite build",
    "clean": "rm -rf dist server.js",
    "splash": "bun scripts/generate-splash.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/mistral": "^4.0.87",
    "@ai-sdk/react": "^4.0.177",
    "@google/genai": "^3.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^7.0.173",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.6",
    "postcss": "^8.5.33",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
